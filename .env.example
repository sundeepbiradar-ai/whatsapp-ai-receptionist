# Application
NEXT_PUBLIC_APP_NAME=AI Customer Operations Platform
NEXT_PUBLIC_APP_VERSION=0.1.0

# Supabase — Public (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase — Server-only (NEVER expose to browser)
# Uncomment when ready to use: SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp durable retry worker — server-only, never exposed to the browser.
# Authenticates POST /api/internal/whatsapp/retry. In production the same value
# is stored in Supabase Vault as `whatsapp_retry_worker_secret` (alongside
# `whatsapp_retry_worker_url`) so pg_cron can call the endpoint. Leave unset to
# keep the endpoint disabled.
# WHATSAPP_RETRY_WORKER_SECRET=generate-a-long-random-value

# Runtime RLS integration tests (dedicated non-production project only)
# SUPABASE_TEST_URL=https://your-test-project.supabase.co
# SUPABASE_TEST_ANON_KEY=your-test-anon-key
# SUPABASE_TEST_SERVICE_ROLE_KEY=your-test-service-role-key

# Database (managed by Supabase PostgreSQL)
# Configured via Supabase project settings

# API Endpoints (Phase 2+)
# NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Feature Flags
# NEXT_PUBLIC_ENABLE_WHATSAPP=false
# NEXT_PUBLIC_ENABLE_APPOINTMENTS=false
# NEXT_PUBLIC_ENABLE_BILLING=false
