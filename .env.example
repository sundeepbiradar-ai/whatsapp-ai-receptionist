# Application
NEXT_PUBLIC_APP_NAME=AI Customer Operations Platform
NEXT_PUBLIC_APP_VERSION=0.1.0

# Supabase — Public (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Absolute site URL used to build auth callback redirects. Required in
# production; without it redirects fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Server-only (NEVER expose to browser)
# Required in production. Used only by the WhatsApp pipeline, status
# correlation and the durable retry worker.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp durable retry worker — server-only, never exposed to the browser.
# Authenticates POST /api/internal/whatsapp/retry. In production the same value
# is stored in Supabase Vault as `whatsapp_retry_worker_secret` (alongside
# `whatsapp_retry_worker_url`) so pg_cron can call the endpoint. Leave unset to
# keep the endpoint disabled.
# WHATSAPP_RETRY_WORKER_SECRET=generate-a-long-random-value

# AI intent detection — server-only, never exposed to the browser.
# Leave unset to keep classification disabled; results then fall back to
# unknown with requiresClarification=true.
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_INTENT_MODEL=gpt-4o-mini

# Runtime RLS integration tests (dedicated non-production project only)
# SUPABASE_TEST_URL=https://your-test-project.supabase.co
# SUPABASE_TEST_ANON_KEY=your-test-anon-key
# SUPABASE_TEST_SERVICE_ROLE_KEY=your-test-service-role-key

# WhatsApp Meta test harness (local development only; NEVER set in production).
# Enables POST /api/test/whatsapp/meta-harness, which simulates a Meta webhook
# delivery against the real inbound pipeline while capturing the outbound
# reply instead of calling the Meta Graph API. Always disabled when
# NODE_ENV=production, even if this flag is set. Additionally, the harness
# only runs when NEXT_PUBLIC_SUPABASE_URL exactly equals SUPABASE_TEST_URL,
# so it can only ever write to the dedicated non-production test project.
# WHATSAPP_TEST_HARNESS_ENABLED=true

# Database (managed by Supabase PostgreSQL)
# Configured via Supabase project settings

# API Endpoints (Phase 2+)
# NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Feature Flags
# NEXT_PUBLIC_ENABLE_WHATSAPP=false
# NEXT_PUBLIC_ENABLE_APPOINTMENTS=false
# NEXT_PUBLIC_ENABLE_BILLING=false
